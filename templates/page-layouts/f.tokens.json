    "stepperHeight": { "$value": "56px", "$type": "dimension" },
    "buttonHeight": { "$value": "35px", "$type": "dimension" },
    "chipHeight": { "$value": "26px", "$type": "dimension" },
    "railWidth": { "$value": "300px", "$type": "dimension", "$description": "Fixed. The rail never grows or shrinks." }
  },
  "font": {
    "family": { "$value": "Inter", "$type": "fontFamily", "$description": "Latin face of the sketch. An Arabic build substitutes its own and keeps the scale." },
