      "regular": { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "size": {
      "ask": { "$value": "20px", "$type": "dimension", "$description": "The question. The only large type on the page." },
      "body": { "$value": "12px", "$type": "dimension", "$description": "The instruction line under the question." },
      "button": { "$value": "11px", "$type": "dimension" },
      "meta": { "$value": "10px", "$type": "dimension", "$description": "Step labels, rail card headings, rail rows, and the checked count." }
    }
