{
  "color": {
    "surface": {
      "topbar": {
        "$value": "#f7f7f7",
        "$type": "color",
        "$description": "Band ground for the identity strip and the paging strip."
      },
      "filters": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Band ground for the filter row, held apart from the topbar by a hairline border rather than a tone change."
      },
      "bulkbar": {
        "$value": "#fafafa",
        "$type": "color",
        "$description": "Band ground for the selection and bulk-action strip."
      },
      "columnHeader": {
        "$value": "#ededed",
        "$type": "color",
        "$description": "Darkest band ground in the set; separates the column labels from the data below without a rule."
      },
      "rowOdd": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "First zebra phase."
      },
      "rowEven": {
        "$value": "#fbfbfb",
        "$type": "color",
        "$description": "Second zebra phase; carries the row boundary in place of a horizontal rule."
      },
      "rule": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "The 1px filler rule that spans the free width inside the topbar, bulkbar and paging bands."
      }
    },
    "control": {
      "filter": {
        "$value": "#f0f0f0",
        "$type": "color",
        "$description": "Filter control fill on the white filter band."
      },
      "chip": {
        "$value": "#ededed",
        "$type": "color",
        "$description": "Counter chip fill in the topbar."
      },
      "button": {
        "$value": "#e0e0e0",
        "$type": "color",
        "$description": "Bulk-action button fill; one step darker than the chip so an action reads as pressable and a counter does not."
      },
      "checkbox": {
        "$value": "#dbdbdb",
        "$type": "color",
        "$description": "Unchecked row selector."
      },
      "rowAction": {
        "$value": "#ebebeb",
        "$type": "color",
        "$description": "Trailing per-row action chip."
      }
    },
    "border": {
      "hairline": {
        "$value": "#e6e6e6",
        "$type": "color",
        "$description": "The single border in the layout, drawn around the filter band."
      }
    },
    "text": {
      "brand": {
        "$value": "#333333",
        "$type": "color",
        "$description": "Page identity; the darkest text in the set."
      },
      "value": {
        "$value": "#404040",
        "$type": "color",
        "$description": "Counter chip figure."
      },
      "action": {
        "$value": "#4d4d4d",
        "$type": "color",
        "$description": "Selection count and bulk-action button labels."
      },
      "columnLabel": {
        "$value": "#6b6b6b",
        "$type": "color",
        "$description": "Column header label."
      },
      "meta": {
        "$value": "#737373",
        "$type": "color",
        "$description": "Paging figures."
      },
      "chipLabel": {
        "$value": "#808080",
        "$type": "color",
        "$description": "The category word beside a counter chip figure."
      },
      "count": {
        "$value": "#8c8c8c",
        "$type": "color",
        "$description": "Total row count at the trailing edge of the bulkbar; the quietest text in the set."
      }
    },
    "content": {
      "emphasis": {
        "$value": "#d6d6d6",
        "$type": "color",
        "$description": "Heaviest content weight; carries the Status column."
      },
      "primary": {
        "$value": "#e0e0e0",
        "$type": "color",
        "$description": "Subject column content weight."
      },
      "secondary": {
        "$value": "#e6e6e6",
        "$type": "color",
        "$description": "Every remaining data column."
      }
    }
